# Farthing configuration. Copy to .env and fill in. Never commit .env.

# --- PayPal (required for live mode) ---
# Create a sandbox app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox or live
PAYPAL_ENV=sandbox

# --- Brain provider ---
# heuristic (zero-setup fallback) | ollama (local SLM, default for real use) | openai (any OpenAI-compatible endpoint)
BRAIN_PROVIDER=heuristic

# ollama settings (https://ollama.com - one-command install, runs 1-8B models locally)
OLLAMA_HOST=http://127.0.0.1:11434
# base model; load a fine-tuned adapter with `ollama create farthing -f training/Modelfile`
OLLAMA_MODEL=qwen3:1.7b

# openai-compatible settings (used for the cloud baseline benchmark)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3-32b
# list price per 1M tokens [input, output] in USD, used ONLY for cost math in the benchmark
OPENAI_PRICE_PER_MTOK=0.10,0.30

# --- Agent behaviour ---
# minutes between scans when running as a service
SCAN_INTERVAL_MINUTES=60
# tone ladder thresholds (days overdue): gentle <= GENTLE_MAX < firm <= FIRM_MAX < final
GENTLE_MAX_DAYS=7
FIRM_MAX_DAYS=21

# --- Server ---
PORT=4173
# set FARTHING_MOCK=1 to run the whole loop against a fixture PayPal dataset (no credentials)

# Optional: force CPU-only Ollama inference for hardware-verified runs
# OLLAMA_NUM_GPU=0

# Bound model connection and body reads (default 30 seconds, max 120 seconds)
BRAIN_TIMEOUT_MS=30000
